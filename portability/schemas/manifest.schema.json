{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "reference_harness_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "core",
              "tooling",
              "test"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "scope",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "spec_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fixture_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "conformance_suites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "spec_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "fixture_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "surfaces",
          "spec_files",
          "reference_files",
          "fixture_files",
          "cases",
          "scenarios",
          "conformance_suites",
          "reference_digest",
          "spec_digest",
          "fixture_digest"
        ],
        "additionalProperties": false
      }
    },
    "contract_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "required_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "reference_harness_version",
    "scope",
    "inventory",
    "operations",
    "contract_files",
    "required_checks",
    "review_policy"
  ],
  "additionalProperties": false
}
