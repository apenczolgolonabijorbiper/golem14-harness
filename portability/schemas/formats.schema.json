{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local interchange formats; select a $defs role, then apply normative semantic rules",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "path": {
          "type": "string",
          "pattern": "^inbox/[0-9a-f-]{36}\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "person",
            "place",
            "event",
            "organization",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,40}$"
        },
        "external_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/external_id"
          }
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "aliases",
        "source_ids",
        "created_at",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "object": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,100}$"
            }
          },
          "required": [
            "entity_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "time": {
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expression": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "unknown",
            "exact",
            "partial",
            "as_reported"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "expression",
        "precision"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "observation_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,80}$"
        },
        "object": {
          "$ref": "#/$defs/object"
        },
        "classification": {
          "type": "string",
          "enum": [
            "source_assertion",
            "hypothesis",
            "corroborated"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "asserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_time": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "retracted"
          ]
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,100}$"
          },
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "attributed_to_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$",
          "description": "Entity to which the source assertion is attributed: a person, organization, system or account; not necessarily a human speaker."
        },
        "depends_on": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,100}$"
          }
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "object",
        "classification",
        "sources",
        "asserted_at",
        "valid_time",
        "status",
        "supersedes",
        "uncertainty",
        "created_at",
        "attributed_to_id"
      ],
      "additionalProperties": false
    },
    "external_id": {
      "type": "object",
      "properties": {
        "scheme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,40}$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "scheme",
        "namespace",
        "value"
      ],
      "additionalProperties": false
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "profile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{1,40}$"
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kinds": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "id",
                      "path",
                      "kinds"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 100
                },
                "vocabulary": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    },
    "vocabulary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 2
        },
        "kinds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{1,40}$"
          },
          "maxItems": 500,
          "uniqueItems": true
        },
        "predicates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,80}$"
          },
          "maxItems": 500,
          "uniqueItems": true
        },
        "single_valued": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,80}$"
          },
          "maxItems": 500,
          "uniqueItems": true
        },
        "external_id_schemes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scheme": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{1,40}$"
              },
              "prefixes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^\\S+$"
                },
                "uniqueItems": true,
                "maxItems": 20
              }
            },
            "required": [
              "scheme"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "status": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "source_observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "answer": {},
        "analysis": {
          "type": "object",
          "properties": {
            "source_observation_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "status": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "status",
        "text",
        "source_observation_id"
      ],
      "additionalProperties": false
    },
    "queue": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "required": [
        "schema_version",
        "questions"
      ],
      "additionalProperties": true
    },
    "processed-row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_file": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "const": "processed"
        },
        "processed_at": {
          "type": "string",
          "format": "date-time"
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run": {
          "type": "string"
        },
        "verification_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_file",
        "source_sha256",
        "status"
      ],
      "additionalProperties": true
    },
    "ledger": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processed-row"
          }
        }
      },
      "required": [
        "schema_version",
        "observations"
      ],
      "additionalProperties": true
    },
    "lease-source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "additionalProperties": true
    },
    "lease": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "idle",
            "processing",
            "error"
          ]
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lease-source"
          },
          "maxItems": 20
        },
        "guidance_version": {
          "type": "object"
        },
        "last_run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "status",
        "observation_ids"
      ],
      "additionalProperties": true
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        },
        "interpretation": {
          "const": "not_inferred"
        },
        "question": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {},
            "source": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "text",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "source_file",
        "sha256",
        "recorded_at",
        "event_date",
        "kind",
        "text",
        "interpretation"
      ],
      "additionalProperties": false
    },
    "chat-event": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "question_id": {
          "type": "string"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64000
        },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "observation_id",
        "question_id",
        "answer",
        "answered_at"
      ],
      "additionalProperties": false
    },
    "hypotheses": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "hypotheses": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{2,100}$"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "supported",
                  "refuted",
                  "withdrawn"
                ]
              },
              "confidence": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "support": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,100}$"
                }
              },
              "refutation": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{2,100}$"
                }
              },
              "confidence_basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "observation_ids": {
                "type": "array",
                "maxItems": 128,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              }
            },
            "required": [
              "id",
              "statement",
              "status",
              "support",
              "refutation",
              "confidence",
              "updated_at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "updated_at",
        "hypotheses"
      ],
      "additionalProperties": false
    },
    "candidate-change": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "base_graph_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base_index_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "review": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64000
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\r\\n]+$"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "maxItems": 20000
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "maxItems": 20000
        },
        "entity_additions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                }
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "external_ids": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/external_id"
                }
