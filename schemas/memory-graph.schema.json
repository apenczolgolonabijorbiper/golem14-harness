{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 500
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "maxItems": 5000
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "maxItems": 20000
    }
  },
  "required": [
    "schema_version",
    "updated_at",
    "sources",
    "entities",
    "claims"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golem.local/schemas/memory-graph.schema.json",
  "title": "Source-grounded instance memory graph",
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "path": {
          "type": "string",
          "pattern": "^inbox/[0-9a-f-]{36}\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "recorded_at"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "person",
            "place",
            "event",
            "organization",
            "other"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{1,40}$"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "aliases",
        "source_ids",
        "created_at",
        "uncertainty"
      ],
      "additionalProperties": false
    },
    "object": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{2,100}$"
            }
          },
          "required": [
            "entity_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "time": {
      "type": "object",
      "properties": {
        "from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "expression": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "unknown",
            "exact",
            "partial",
            "as_reported"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "expression",
        "precision"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "observation_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$"
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$",
          "description": "Legacy alias of attributed_to_id; retained historical claims must keep their original field."
        },
        "predicate": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,80}$"
        },
        "object": {
          "$ref": "#/$defs/object"
        },
        "classification": {
          "type": "string",
          "enum": [
            "source_assertion",
            "hypothesis",
            "corroborated",
            "user_declaration",
            "independently_confirmed"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        },
        "asserted_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_time": {
          "$ref": "#/$defs/time"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "superseded",
            "retracted"
          ]
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,100}$"
          },
          "uniqueItems": true
        },
        "uncertainty": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "attributed_to_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{2,100}$",
          "description": "Entity to which the source assertion is attributed: a person, organization, system or account; not necessarily a human speaker."
        }
      },
      "required": [
        "id",
        "subject_id",
        "predicate",
        "object",
        "classification",
        "sources",
        "asserted_at",
        "valid_time",
        "status",
        "supersedes",
        "uncertainty",
        "created_at"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "attributed_to_id"
          ]
        },
        {
          "required": [
            "speaker_id"
          ]
        }
      ]
    }
  }
}
