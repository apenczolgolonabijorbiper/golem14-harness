{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selective processed observations bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "logical_version",
    "origin",
    "selected",
    "rows",
    "evidence",
    "sha256"
  ],
  "properties": {
    "format": {
      "const": "golem-processed-observations"
    },
    "version": {
      "const": 1
    },
    "logical_version": {
      "const": 2
    },
    "origin": {
      "type": "object",
      "required": [
        "instance_id",
        "snapshot_id",
        "logical_version",
        "updated_at",
        "policy_id",
        "policy"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "logical_version": {
          "const": 2
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object"
        }
      }
    },
    "selected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "sources",
        "entities",
        "claims",
        "processed",
        "questions",
        "hypotheses",
        "events",
        "journals",
        "verification",
        "receipts",
        "artifacts"
      ],
      "properties": {
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "processed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "journals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
