{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cognitive learning v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "binding": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "guidance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "instance_id",
        "snapshot_id",
        "guidance_id"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "enum": [
        "add_hypothesis",
        "correct_hypothesis"
      ]
    },
    "target_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "hypothesis_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "support": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 128
    },
    "refutation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 128
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 32
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "verification_needed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 32
    }
  },
  "required": [
    "protocol_version",
    "proposal_id",
    "task_id",
    "binding",
    "operation",
    "target_id",
    "hypothesis_id",
    "statement",
    "support",
    "refutation",
    "uncertainty",
    "rationale",
    "verification_needed"
  ],
  "additionalProperties": false
}
